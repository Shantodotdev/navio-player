{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Navio Player",
  "version": "0.3.0",
  "identifier": "com.navioplayer.com",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "Navio Player",
        "width": 1024,
        "height": 728,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "m4a",
          "flac",
          "ogg",
          "wav",
          "mp4",
          "mkv",
          "webm",
          "avi",
          "mov"
        ],
        "name": "Navio media",
        "description": "Media file for Navio Player",
        "mimeType": "application/octet-stream",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
